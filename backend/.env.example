APP_NAME="Decision Data B2C"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En Docker Compose: DB_HOST=mysql. Corriendo el backend suelto (sin Docker),
# usa 127.0.0.1 y levanta tu propio MySQL en el puerto 3306.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=decision_data
DB_USERNAME=decision_data
DB_PASSWORD=decision_data

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Dominio: motor de casos -------------------------------------------
# 'log' (default, sin credenciales) o 'whatsapp' (requiere las variables de
# abajo). Con 'log', el recorrido completo se puede probar sin Meta.
NOTIFICATION_DRIVER=log
CASOS_DIAS_HABILES_RESPUESTA=15

# --- IA: Claude API (agente Gestor) -------------------------------------
# Vacío -> usa RedactorStub (declarado en AI_USAGE.md). Con una key real,
# el Gestor redacta la oposición llamando a la Claude API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- WhatsApp: Meta Cloud API (solo si NOTIFICATION_DRIVER=whatsapp) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
